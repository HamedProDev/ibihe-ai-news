# Ibihe AI News — environment template.
# Copy to .env.local and fill in. NEVER commit real secrets.

# --- Database (optional; without it the JSON file store is used) ---
# DIRECT Postgres connection string (port 5432) — copy from Supabase:
# Project Settings → Database → Connection string → URI → Direct.
# NOTE: this is NOT the https://xxx.supabase.co project URL (that is the
# API endpoint). This app connects straight to Postgres via the `pg`
# driver, so there are no NEXT_PUBLIC_SUPABASE_* keys here by design.
# Local:  postgres://ibihe:ibihe@localhost:5432/ibihe   (see docker-compose.yml)
# Prod:   use the POOLED string (port 6543) on Vercel, DIRECT for db:migrate.
DATABASE_URL=

# --- AI (optional; without it, labeled rule-based fallbacks are used) ---
ANTHROPIC_API_KEY=

# --- Operational secrets (generate with: openssl rand -hex 32) ---
# Protects POST /api/ingest (+ GET ?run=1) and GET /api/cron/market.
# Vercel Cron sends this automatically as the Bearer token.
CRON_SECRET=
# Protects /api/review and /api/market/import + the /admin UI gate.
ADMIN_SECRET=

# --- Real market upstreams (optional) ---
# Canonical CSV feed URL (format documented in src/lib/market/sources/csv.ts).
ESOKO_FEED_URL=
# Comma list of enabled market adapters. Default: esoko
MARKET_SOURCES=esoko

# --- Public ---
# Public site URL (used for sitemap/robots only — no secrets here).
NEXT_PUBLIC_SITE_URL=https://ibihe.rw
